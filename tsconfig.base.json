{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"lib": [
			"ES2022"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"inlineSourceMap": false,
		"moduleResolution": "NodeNext",
		"resolveJsonModule": true,
		"types": [
			"node"
		]
	}
}
