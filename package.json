{
	"name": "pi-starter",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@9.15.4",
	"scripts": {
		"dev": "pnpm --filter @pi-starter/web dev",
		"clean": "pnpm -r --if-present run clean && rm -rf .cache",
		"build": "pnpm -r --if-present run build",
		"test": "pnpm run test:app && pnpm run test:repo",
		"test:app": "pnpm -r --if-present run test",
		"test:repo": "node --test scripts/test/*.test.mjs",
		"pr:ready": "node scripts/pr-readiness.mjs",
		"pr:size": "node scripts/pr-size.mjs",
		"fallow:audit": "fallow audit --changed-since origin/main",
		"preview:cloudflare": "pnpm --filter @pi-starter/web run cf:preview",
		"build:cloudflare": "pnpm --filter @pi-starter/web run cf:build",
		"deploy:cloudflare": "pnpm --filter @pi-starter/web run cf:deploy",
		"typegen:cloudflare": "pnpm --filter @pi-starter/web run cf:typegen",
		"preflight:native-deps": "node scripts/preflight-native-deps.mjs",
		"check": "node scripts/check.mjs",
		"ci:validate": "node scripts/ci-validate.mjs",
		"fix": "pnpm run preflight:native-deps && biome check --write --error-on-warnings .",
		"doctor": "node scripts/doctor.mjs",
		"docs:list": "node scripts/docs-list.mjs",
		"agent:check": "node scripts/agent-check.mjs",
		"agent:verify-upstream": "node scripts/agent-sync.mjs verify",
		"skills:sync": "node scripts/agent-sync.mjs sync",
		"skills:verify": "node scripts/agent-sync.mjs verify-local",
		"init:project": "node scripts/init-project.mjs",
		"commit:selective": "bash scripts/committer",
		"commit:with-progress": "node scripts/commit-with-progress.mjs",
		"reinstall:clean": "node scripts/reinstall-clean.mjs",
		"version:sync": "node scripts/sync-versions.js && pnpm install --lockfile-only --ignore-scripts",
		"version:patch": "pnpm -r exec npm version patch --no-git-tag-version && pnpm run version:sync",
		"version:minor": "pnpm -r exec npm version minor --no-git-tag-version && pnpm run version:sync",
		"version:major": "pnpm -r exec npm version major --no-git-tag-version && pnpm run version:sync",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:tag": "node scripts/release-tag.mjs",
		"prepare": "node scripts/prepare.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "^26.6.6",
		"fallow": "3.41.0",
		"husky": "^9.1.7",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	},
	"engines": {
		"node": "26.x"
	}
}
