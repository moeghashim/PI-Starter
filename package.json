{
	"name": "pi-starter",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "npm@11.6.2",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"test": "node --test scripts/test/*.test.mjs && npm run test --workspaces --if-present",
		"fallow:audit": "fallow audit --changed-since origin/main",
		"preview:cloudflare": "npm run cf:preview -w @pi-starter/web",
		"build:cloudflare": "npm run cf:build -w @pi-starter/web",
		"deploy:cloudflare": "npm run cf:deploy -w @pi-starter/web",
		"typegen:cloudflare": "npm run cf:typegen -w @pi-starter/web",
		"preflight:native-deps": "node scripts/preflight-native-deps.mjs",
		"check": "npm run preflight:native-deps && biome check --error-on-warnings . && node scripts/check-file-length.mjs && tsgo --noEmit && npm run check --workspaces --if-present",
		"fix": "npm run preflight:native-deps && biome check --write --error-on-warnings .",
		"doctor": "node scripts/doctor.mjs",
		"docs:list": "node scripts/docs-list.mjs",
		"agent:verify-sync": "node scripts/agent-sync.mjs verify",
		"agent:sync": "node scripts/agent-sync.mjs sync",
		"skills:verify-sync": "node scripts/agent-sync.mjs verify --manifest agent/skills-manifest.json",
		"skills:sync": "node scripts/agent-sync.mjs sync --manifest agent/skills-manifest.json",
		"skills:addy:verify-sync": "node scripts/agent-sync.mjs verify --manifest agent/skills-manifest.addyosmani.json",
		"skills:addy:sync": "node scripts/agent-sync.mjs sync --manifest agent/skills-manifest.addyosmani.json",
		"skills:matt:verify-sync": "node scripts/agent-sync.mjs verify --manifest agent/skills-manifest.mattpocock.json",
		"skills:matt:sync": "node scripts/agent-sync.mjs sync --manifest agent/skills-manifest.mattpocock.json",
		"skills:chrome:verify-sync": "node scripts/agent-sync.mjs verify --manifest agent/skills-manifest.chromedevtools.json",
		"skills:chrome:sync": "node scripts/agent-sync.mjs sync --manifest agent/skills-manifest.chromedevtools.json",
		"skills:verify-sync:all": "npm run skills:verify-sync && npm run skills:addy:verify-sync && npm run skills:matt:verify-sync && npm run skills:chrome:verify-sync",
		"skills:sync:all": "npm run skills:sync && npm run skills:addy:sync && npm run skills:matt:sync && npm run skills:chrome:sync",
		"agent:check": "node scripts/agent-check.mjs",
		"commit:selective": "bash scripts/committer",
		"commit:with-progress": "node scripts/commit-with-progress.mjs",
		"reinstall:clean": "node scripts/reinstall-clean.mjs",
		"version:patch": "npm version patch -ws --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
		"version:minor": "npm version minor -ws --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
		"version:major": "npm version major -ws --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"prepare": "node scripts/prepare.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"fallow": "3.9.1",
		"husky": "^9.1.7",
		"tsx": "^4.23.1",
		"typescript": "^5.9.2"
	},
	"overrides": {
		"@node-minify/core": {
			"glob": "12.0.0"
		},
		"next": {
			"postcss": "8.5.23",
			"sharp": "0.35.3"
		}
	},
	"engines": {
		"node": "22.x"
	}
}
