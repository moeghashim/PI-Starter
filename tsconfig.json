{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "./.cache/tsbuildinfo/root.tsbuildinfo",
		"paths": {
			"@pi-starter/*": [
				"./packages/*/src/index.ts"
			]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*"
	],
	"exclude": [
		"**/dist/**"
	]
}
