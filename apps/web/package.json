{
	"name": "@pi-starter/web",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "rm -rf dist .output .nitro .tanstack .wrangler",
		"dev": "vite dev",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"cf:build": "vite build --mode cloudflare",
		"cf:preview": "pnpm run cf:build && vite preview --mode cloudflare",
		"cf:deploy": "pnpm run cf:build && wrangler deploy",
		"cf:typegen": "node scripts/cloudflare-typegen.mjs",
		"check": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
		"test": "tsx --tsconfig tsconfig.json --test \"test/**/*.test.ts\""
	},
	"dependencies": {
		"@fontsource/instrument-serif": "5.3.0",
		"@fontsource/space-grotesk": "5.3.0",
		"@pi-starter/core": "workspace:^",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.5",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.69.0",
		"@types/node": "^26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"nitro": "3.0.261103-rc",
		"vite": "8.3.8",
		"wrangler": "4.160.0"
	},
	"engines": {
		"node": "26.x"
	}
}
