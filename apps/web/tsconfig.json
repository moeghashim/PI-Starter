{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": false,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2022"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "../../.cache/tsbuildinfo/web.tsbuildinfo",
		"verbatimModuleSyntax": false,
		"types": [
			"vite/client"
		],
		"paths": {
			"@pi-starter/core": [
				"../../packages/core/src/index.ts"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx"
	]
}
